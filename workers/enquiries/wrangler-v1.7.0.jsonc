{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sw-enquiries",
  "main": "worker-v1.7.0.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "routes": [{"pattern": "enquiries.superwebsites.co.nz", "custom_domain": true}],
  "vars": {
    "ENQUIRIES_ENABLED": "false",
    "SENDER_EMAIL": "website@forms.superwebsites.co.nz"
  },
  "send_email": [{
    "name": "ENQUIRY_EMAIL",
    "destination_address": "hello@superwebsites.co.nz"
  }],
  "ratelimits": [{
    "name": "ENQUIRY_RATE_LIMIT",
    "namespace_id": "170001",
    "simple": {"limit": 5, "period": 60}
  }],
  "observability": {"enabled": false}
}
