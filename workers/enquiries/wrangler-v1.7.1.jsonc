// Super Websites enquiry service v1.7.1 — Resend; API key is a runtime secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sw-enquiries",
  "main": "worker-v1.7.1.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "enquiries.superwebsites.co.nz",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENQUIRIES_ENABLED": "true",
    "SENDER_EMAIL": "website@forms.superwebsites.co.nz"
  },
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMIT",
      "namespace_id": "170001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
